{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrajViz Obs usage report",
  "description": "An aggregate snapshot of opt-in plugin activity. All dates are UTC and windows include both endpoints.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {"not": {"anyOf": [{"required": ["activity"]}, {"required": ["usage"]}]}},
      "else": {"required": ["activity"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": 3}}},
      "then": {"required": ["usage"]},
      "else": {"not": {"required": ["usage"]}}
    }
  ],
  "required": [
    "format", "schema_version", "as_of", "period_start", "retained_from", "retention_days",
    "adoption", "daily", "engagement", "features", "surfaces", "versions", "retention"
  ],
  "properties": {
    "format": {"const": "trajviz-obs-usage-report"},
    "schema_version": {"type": "integer", "enum": [1, 2, 3]},
    "as_of": {"$ref": "#/$defs/day", "description": "Last day in the reporting window."},
    "period_start": {"$ref": "#/$defs/day", "description": "First day in the reporting window."},
    "retained_from": {"$ref": "#/$defs/day", "description": "First day in the available retention window."},
    "retention_days": {"type": "integer", "minimum": 32, "maximum": 365},
    "adoption": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/adoption"}},
    "daily": {
      "type": "array",
      "minItems": 2,
      "maxItems": 730,
      "items": {"$ref": "#/$defs/daily"},
      "description": "One row per adapter per reporting day, including days with zero activity."
    },
    "engagement": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/engagement"}},
    "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "surfaces": {"type": "array", "items": {"$ref": "#/$defs/surface"}},
    "versions": {"type": "array", "items": {"$ref": "#/$defs/version"}},
    "retention": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/retention"},
      "description": "One cohort row per adapter and offset. The 7-day and 30-day rates use exact-day returns."
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rolling", "features"],
      "properties": {
        "rolling": {"$ref": "#/$defs/usage_rolling"},
        "features": {
          "type": "array", "items": {"$ref": "#/$defs/usage_feature"},
          "description": "Usage and outcomes by adapter, host agent version and feature in the reporting period."
        }
      }
    },
    "activity": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/activity_windows"}],
      "unevaluatedProperties": false,
      "required": ["by_adapter", "by_agent_version"],
      "properties": {
        "by_adapter": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/activity_adapter"}
        },
        "by_agent_version": {
          "type": "array", "items": {"$ref": "#/$defs/activity_agent_version"},
          "description": "Counts in the selected period by adapter and host agent version, separate from plugin versions."
        }
      }
    }
  },
  "$defs": {
    "day": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "adapter": {"enum": ["claude-code", "opencode"]},
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "nullable_count": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
    "usage_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "active_installations", "returning_installations"],
      "properties": {
        "start": {"$ref": "#/$defs/day", "description": "First UTC day of a window ending on as_of."},
        "active_installations": {
          "$ref": "#/$defs/count",
          "description": "Distinct adapter-scoped installations with at least one event in the window."
        },
        "returning_installations": {
          "$ref": "#/$defs/count",
          "description": "Active installations first observed before the first day of the window."
        }
      }
    },
    "usage_windows": {
      "type": "object",
      "required": ["last_7_days", "last_30_days"],
      "properties": {
        "last_7_days": {"$ref": "#/$defs/usage_window"},
        "last_30_days": {"$ref": "#/$defs/usage_window"}
      }
    },
    "usage_adapter": {
      "allOf": [{"$ref": "#/$defs/usage_windows"}],
      "unevaluatedProperties": false,
      "required": ["adapter"],
      "properties": {"adapter": {"$ref": "#/$defs/adapter"}}
    },
    "usage_rolling": {
      "allOf": [{"$ref": "#/$defs/usage_windows"}],
      "unevaluatedProperties": false,
      "required": ["by_adapter"],
      "properties": {
        "by_adapter": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/usage_adapter"}}
      }
    },
    "usage_feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter", "agent_version", "category", "feature", "invocations", "installations", "outcomes",
        "duration_buckets", "completed", "success_rate", "error_rate", "cancelled_rate",
        "p50_duration_bucket", "p95_duration_bucket"
      ],
      "properties": {
        "adapter": {"$ref": "#/$defs/adapter"},
        "agent_version": {"anyOf": [{"$ref": "#/$defs/plugin_version"}, {"type": "null"}]},
        "category": {"enum": ["command", "dashboard", "pane"]},
        "feature": {"$ref": "#/$defs/feature_name"},
        "invocations": {"$ref": "#/$defs/invocations"},
        "installations": {"$ref": "#/$defs/count"},
        "outcomes": {
          "type": "object", "propertyNames": {"$ref": "#/$defs/outcome"},
          "additionalProperties": {"$ref": "#/$defs/count"},
          "description": "All recorded outcomes. An omitted outcome has zero observations."
        },
        "duration_buckets": {
          "type": "object", "propertyNames": {"$ref": "#/$defs/duration_bucket"},
          "additionalProperties": {"$ref": "#/$defs/count"},
          "description": "Duration histogram for successful and failed attempts."
        },
        "completed": {
          "$ref": "#/$defs/count",
          "description": "Comparable recorded dispositions: success, error or cancelled. The three outcome rates divide by this count."
        },
        "success_rate": {"$ref": "#/$defs/rate"},
        "error_rate": {"$ref": "#/$defs/rate"},
        "cancelled_rate": {"$ref": "#/$defs/rate"},
        "p50_duration_bucket": {"$ref": "#/$defs/percentile"},
        "p95_duration_bucket": {"$ref": "#/$defs/percentile"}
      }
    },
    "activity_counts": {
      "type": "object",
      "required": [
        "distinct_addresses", "distinct_installations", "distinct_address_installation_pairs",
        "events", "events_with_address", "events_with_agent_version"
      ],
      "properties": {
        "distinct_addresses": {
          "$ref": "#/$defs/nullable_count",
          "description": "Distinct observed network addresses, including addresses shared by both adapters. Null means no observed addresses."
        },
        "distinct_installations": {
          "$ref": "#/$defs/count",
          "description": "Distinct active plugin installations. An installation identity is scoped to one adapter."
        },
        "distinct_address_installation_pairs": {
          "$ref": "#/$defs/nullable_count",
          "description": "Distinct observed address and adapter-scoped installation pairs. Null means no observed addresses."
        },
        "events": {"$ref": "#/$defs/count", "description": "All accepted observations in scope, including activations."},
        "events_with_address": {"$ref": "#/$defs/count"},
        "events_with_agent_version": {"$ref": "#/$defs/count"}
      }
    },
    "activity_window": {"$ref": "#/$defs/activity_counts", "unevaluatedProperties": false},
    "activity_day": {
      "allOf": [{"$ref": "#/$defs/activity_counts"}],
      "unevaluatedProperties": false,
      "required": ["day"],
      "properties": {"day": {"$ref": "#/$defs/day"}}
    },
    "activity_windows": {
      "type": "object",
      "required": ["today", "period", "last_30_days", "daily"],
      "properties": {
        "today": {"$ref": "#/$defs/activity_window", "description": "Counts on as_of, which may be a historical date."},
        "period": {"$ref": "#/$defs/activity_window", "description": "Distinct counts across the selected report period."},
        "last_30_days": {"$ref": "#/$defs/activity_window", "description": "Distinct counts across 30 UTC days ending on as_of."},
        "daily": {
          "type": "array", "minItems": 1, "maxItems": 365, "items": {"$ref": "#/$defs/activity_day"},
          "description": "One row for every day in the report period, including days with zero events."
        }
      }
    },
    "activity_adapter": {
      "allOf": [{"$ref": "#/$defs/activity_windows"}],
      "unevaluatedProperties": false,
      "required": ["adapter"],
      "properties": {"adapter": {"$ref": "#/$defs/adapter"}}
    },
    "activity_agent_version": {
      "allOf": [{"$ref": "#/$defs/activity_counts"}],
      "unevaluatedProperties": false,
      "required": ["adapter", "agent_version"],
      "properties": {
        "adapter": {"$ref": "#/$defs/adapter"},
        "agent_version": {
          "anyOf": [{"$ref": "#/$defs/plugin_version"}, {"type": "null"}],
          "description": "Reported host agent version. Null means unknown or unreported."
        }
      }
    },
    "invocations": {
      "$ref": "#/$defs/count",
      "description": "Recorded actions other than activation, including browser observations."
    },
    "average": {"type": ["number", "null"], "minimum": 0, "maximum": 9007199254740991},
    "rate": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Fraction of the eligible denominator, rounded to four decimal places. Null means no eligible denominator."
    },
    "outcome": {"enum": ["success", "error", "cancelled", "empty", "rejected", "confirmation", "observed"]},
    "duration_bucket": {"enum": ["lt_100ms", "100ms_1s", "1s_5s", "5s_30s", "gte_30s"]},
    "percentile": {
      "anyOf": [{"$ref": "#/$defs/duration_bucket"}, {"type": "null"}],
      "description": "A latency bucket for successful and failed attempts. Null means no such attempts."
    },
    "plugin_version": {
      "type": "string",
      "not": {"pattern": "[\r\n]"},
      "pattern": "^(?:0|[1-9][0-9]{0,3})(?:\\.(?:0|[1-9][0-9]{0,3})){2}(?:-(?:alpha|beta|rc)\\.[0-9]{1,3})?$"
    },
    "feature_name": {
      "enum": [
        "overview", "pane", "pane.close", "pane.refresh", "pane.tab", "pane.expand", "issues", "health",
        "patterns", "agents", "context", "timeline", "view", "json", "bundle", "schemas", "dashboard",
        "dashboard.html", "dashboard.stop", "converge", "converge.stop", "compare", "scorecard", "labels",
        "converge-cli", "analyze", "fixes", "label", "attribution", "collect", "sessions", "watch",
        "statusline", "setup", "doctor", "help", "brief", "tool", "dashboard.render", "dashboard.tab",
        "dashboard.inspect", "dashboard.load", "dashboard.export", "dashboard.compare", "dashboard.analyze",
        "dashboard.attribution", "converge.render", "converge.tab", "converge.compare"
      ]
    },
    "surface_name": {"enum": ["terminal", "desktop", "headless", "browser", "unknown"]},
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter", "observed_installations", "new_installations", "active_today", "active_last_30_days",
        "active_in_period", "engaged_in_period", "activation_only_in_period", "returning_in_period",
        "returning_engaged_in_period"
      ],
      "properties": {
        "adapter": {"$ref": "#/$defs/adapter"},
        "observed_installations": {
          "$ref": "#/$defs/count",
          "description": "Distinct opt-in installations with an event from retained_from through as_of."
        },
        "new_installations": {
          "$ref": "#/$defs/count",
          "description": "Installations first observed during the reporting window."
        },
        "active_today": {"$ref": "#/$defs/count", "description": "Distinct installations active on as_of."},
        "active_last_30_days": {
          "$ref": "#/$defs/count",
          "description": "Distinct installations active in the 30 UTC days ending on as_of."
        },
        "active_in_period": {"$ref": "#/$defs/count"},
        "engaged_in_period": {"$ref": "#/$defs/count"},
        "activation_only_in_period": {"$ref": "#/$defs/count"},
        "returning_in_period": {"$ref": "#/$defs/count"},
        "returning_engaged_in_period": {"$ref": "#/$defs/count"}
      }
    },
    "daily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day", "adapter", "active_installations", "engaged_installations", "new_installations",
        "returning_installations", "invocations"
      ],
      "properties": {
        "day": {"$ref": "#/$defs/day"},
        "adapter": {"$ref": "#/$defs/adapter"},
        "active_installations": {"$ref": "#/$defs/count"},
        "engaged_installations": {"$ref": "#/$defs/count"},
        "new_installations": {"$ref": "#/$defs/count"},
        "returning_installations": {"$ref": "#/$defs/count"},
        "invocations": {"$ref": "#/$defs/invocations"}
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter", "invocations", "engaged_installations", "engaged_on_multiple_days",
        "average_invocations_per_engaged_installation", "average_days_per_engaged_installation"
      ],
      "properties": {
        "adapter": {"$ref": "#/$defs/adapter"},
        "invocations": {"$ref": "#/$defs/invocations"},
        "engaged_installations": {"$ref": "#/$defs/count"},
        "engaged_on_multiple_days": {"$ref": "#/$defs/count"},
        "average_invocations_per_engaged_installation": {"$ref": "#/$defs/average"},
        "average_days_per_engaged_installation": {"$ref": "#/$defs/average"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter", "feature", "invocations", "installations", "outcomes", "duration_buckets", "executed",
        "success_rate", "error_rate", "p50_duration_bucket", "p95_duration_bucket"
      ],
      "properties": {
        "adapter": {"$ref": "#/$defs/adapter"},
        "feature": {"$ref": "#/$defs/feature_name"},
        "invocations": {"$ref": "#/$defs/invocations"},
        "installations": {"$ref": "#/$defs/count"},
        "outcomes": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/outcome"},
          "additionalProperties": {"$ref": "#/$defs/count"},
          "description": "Sparse counts by outcome. An omitted outcome has zero observations."
        },
        "duration_buckets": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/duration_bucket"},
          "additionalProperties": {"$ref": "#/$defs/count"},
          "description": "Sparse latency histogram for successful and failed attempts."
        },
        "executed": {"$ref": "#/$defs/count", "description": "Attempts that ended with success or error."},
        "success_rate": {"$ref": "#/$defs/rate"},
        "error_rate": {"$ref": "#/$defs/rate"},
        "p50_duration_bucket": {"$ref": "#/$defs/percentile"},
        "p95_duration_bucket": {"$ref": "#/$defs/percentile"}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "surface", "invocations", "installations"],
      "properties": {
        "adapter": {"$ref": "#/$defs/adapter"},
        "surface": {"$ref": "#/$defs/surface_name"},
        "invocations": {"$ref": "#/$defs/invocations"},
        "installations": {"$ref": "#/$defs/count"}
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "version", "invocations", "installations"],
      "properties": {
        "adapter": {"$ref": "#/$defs/adapter"},
        "version": {"$ref": "#/$defs/plugin_version"},
        "invocations": {"$ref": "#/$defs/invocations"},
        "installations": {"$ref": "#/$defs/count"}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "days_after_first_seen", "eligible_installations", "returned_installations", "rate"],
      "properties": {
        "adapter": {"$ref": "#/$defs/adapter"},
        "days_after_first_seen": {"enum": [7, 30]},
        "eligible_installations": {"$ref": "#/$defs/count"},
        "returned_installations": {"$ref": "#/$defs/count"},
        "rate": {"$ref": "#/$defs/rate"}
      }
    }
  }
}
